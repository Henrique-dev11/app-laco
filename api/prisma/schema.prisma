generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum TipoUsuario {
  RESPONSAVEL
  CUIDADOR
  ADMIN
  SUPER_ADMIN
}

enum StatusUsuario {
  ATIVO
  BLOQUEADO
  INATIVO
}

enum StatusVerificacao {
  PENDENTE
  APROVADO
  REJEITADO
}

enum Parentesco {
  PROPRIO
  FILHO
  FILHA
  CONJUGE
  NETO
  NETA
  OUTRO
}

enum DiaSemana {
  DOMINGO
  SEGUNDA
  TERCA
  QUARTA
  QUINTA
  SEXTA
  SABADO
}

enum StatusContratacao {
  SOLICITADA
  ACEITA
  RECUSADA
  CANCELADA
  CONCLUIDA
}

model Usuario {
  id          Int           @id @default(autoincrement())
  nome        String        @db.VarChar(150)
  nomeSocial  String?       @db.VarChar(150)
  telefone2   String?       @db.VarChar(20)
  termosAceitosEm DateTime?
  email       String        @unique @db.VarChar(255)
  senhaHash   String        @db.VarChar(255)
  tipoUsuario TipoUsuario
  status      StatusUsuario @default(ATIVO)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  responsavel Responsavel?
  cuidador    Cuidador?
  sessoes     Sessao[]
  preferencias PreferenciaServico[]
  foto        FotoPerfil?
}

model Endereco {
  id          Int     @id @default(autoincrement())
  rua         String  @db.VarChar(150)
  numero      String  @db.VarChar(20)
  complemento String? @db.VarChar(150)
  bairro      String  @db.VarChar(100)
  cidade      String  @db.VarChar(100)
  estado      String  @db.Char(2)
  cep         String  @db.VarChar(8)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  responsaveis Responsavel[]
  idosos       Idoso[]
  cuidadores   Cuidador[]
}

model Responsavel {
  id             Int      @id @default(autoincrement())
  usuarioId      Int      @unique
  enderecoId     Int
  telefone       String   @db.VarChar(20)
  cpf            String   @unique @db.VarChar(11)
  dataNascimento DateTime

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  usuario  Usuario  @relation(fields: [usuarioId], references: [id])
  endereco Endereco @relation(fields: [enderecoId], references: [id])

  responsavelIdosos ResponsavelIdoso[]
  contratacoes      Contratacao[]
  avaliacoes        Avaliacao[]
}

model ResponsavelIdoso {
  id                   Int        @id @default(autoincrement())
  responsavelId        Int
  idosoId              Int
  parentesco           Parentesco
  responsavelPrincipal Boolean    @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  responsavel Responsavel @relation(fields: [responsavelId], references: [id])
  idoso       Idoso       @relation(fields: [idosoId], references: [id])

  @@unique([responsavelId, idosoId])
}

model Idoso {
  id                    Int      @id @default(autoincrement())
  enderecoId            Int
  nome                  String   @db.VarChar(150)
  nomeSocial            String?  @db.VarChar(150)
  dataNascimento        DateTime
  sexo                  String?  @db.VarChar(30)
  telefone              String?  @db.VarChar(20)
  cpf                   String?  @unique @db.VarChar(11)
  observacoes           String?  @db.Text
  necessidadesEspeciais String?  @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  endereco Endereco @relation(fields: [enderecoId], references: [id])

  responsavelIdosos ResponsavelIdoso[]
  contratacoes      Contratacao[]
}

model Cuidador {
  id                      Int               @id @default(autoincrement())
  usuarioId               Int               @unique
  enderecoId              Int
  telefone                String            @db.VarChar(20)
  cpf                     String            @unique @db.VarChar(11)
  dataNascimento          DateTime
  biografia               String?           @db.Text
  experienciaProfissional String?           @db.Text
  registroProfissional    String?           @db.VarChar(100)
  statusVerificacao       StatusVerificacao @default(PENDENTE)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  usuario  Usuario  @relation(fields: [usuarioId], references: [id])
  endereco Endereco @relation(fields: [enderecoId], references: [id])

  cuidadorServicos CuidadorServico[]
  disponibilidades Disponibilidade[]
  curriculo Curriculo?
  agendamentos Agendamento[]
  avaliacoes Avaliacao[]
}

model Servico {
  id        Int     @id @default(autoincrement())
  nome      String  @db.VarChar(150)
  // Unicidade de nome no catálogo é garantida por índice parcial na migration.
  catalogo Boolean @default(true)
  precoSugerido Decimal? @db.Decimal(10, 2)
  duracaoSugeridaMinutos Int?
  descricao String? @db.Text
  ativo     Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  cuidadorServicos CuidadorServico[]
  preferencias PreferenciaServico[]
  @@index([nome])
}

model CuidadorServico {
  id             Int     @id @default(autoincrement())
  cuidadorId     Int
  servicoId      Int
  preco          Decimal @db.Decimal(10, 2)
  duracaoMinutos Int
  ativo          Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  cuidador Cuidador @relation(fields: [cuidadorId], references: [id])
  servico  Servico  @relation(fields: [servicoId], references: [id])

  contratacoes Contratacao[]

  @@unique([cuidadorId, servicoId])
}

model Disponibilidade {
  id         Int       @id @default(autoincrement())
  cuidadorId Int
  diaSemana  DiaSemana
  horaInicio DateTime  @db.Time(0)
  horaFim    DateTime  @db.Time(0)
  ativo      Boolean   @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  cuidador Cuidador @relation(fields: [cuidadorId], references: [id])

  @@unique([cuidadorId, diaSemana, horaInicio, horaFim])
}

model Contratacao {
  id                Int               @id @default(autoincrement())
  responsavelId     Int
  idosoId           Int
  cuidadorServicoId Int
  nomeServico       String            @db.VarChar(150)
  precoReferencia   Decimal           @db.Decimal(10, 2)
  duracaoMinutos    Int
  valorAcordado     Decimal           @db.Decimal(10, 2)
  status            StatusContratacao @default(SOLICITADA)
  observacoes       String?           @db.Text

  // Código de conclusão: só o hash é guardado; o código em si é mostrado apenas ao responsável.
  codigoConclusaoHash String?
  tentativasCodigo    Int     @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  responsavel     Responsavel     @relation(fields: [responsavelId], references: [id])
  idoso           Idoso           @relation(fields: [idosoId], references: [id])
  cuidadorServico CuidadorServico @relation(fields: [cuidadorServicoId], references: [id])
  agendamento Agendamento?
  avaliacao Avaliacao?
}

model Agendamento {
  id Int @id @default(autoincrement())
  contratacaoId Int @unique
  cuidadorId Int
  inicio DateTime @db.Timestamptz(3)
  fim DateTime @db.Timestamptz(3)
  ativo Boolean @default(true)
  createdAt DateTime @default(now())
  contratacao Contratacao @relation(fields: [contratacaoId], references: [id])
  cuidador Cuidador @relation(fields: [cuidadorId], references: [id])
  @@index([cuidadorId, inicio])
}

model Sessao {
  id String @id @default(uuid())
  tokenHash String @unique @db.Char(64)
  usuarioId Int
  expiraEm DateTime
  createdAt DateTime @default(now())
  usuario Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  @@index([usuarioId])
  @@index([expiraEm])
}

model Curriculo {
  id Int @id @default(autoincrement())
  cuidadorId Int @unique
  nome String @db.VarChar(255)
  conteudo Bytes
  createdAt DateTime @default(now())
  cuidador Cuidador @relation(fields: [cuidadorId], references: [id], onDelete: Cascade)
}

model PreferenciaServico {
  usuarioId Int
  servicoId Int
  usuario Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  servico Servico @relation(fields: [servicoId], references: [id])
  @@id([usuarioId, servicoId])
}

model FotoPerfil {
  usuarioId Int      @id
  mime      String   @db.VarChar(20)
  conteudo  Bytes
  updatedAt DateTime @updatedAt
  usuario   Usuario  @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
}

// Avaliação do responsável sobre um atendimento concluído (uma por contratação).
// A nota (1 a 5) é validada também no banco, por CHECK na migration.
model Avaliacao {
  id            Int      @id @default(autoincrement())
  contratacaoId Int      @unique
  responsavelId Int
  cuidadorId    Int
  nota          Int
  comentario    String?  @db.VarChar(1000)
  createdAt     DateTime @default(now())

  contratacao Contratacao @relation(fields: [contratacaoId], references: [id])
  responsavel Responsavel @relation(fields: [responsavelId], references: [id])
  cuidador    Cuidador    @relation(fields: [cuidadorId], references: [id])

  @@index([cuidadorId, createdAt])
}
