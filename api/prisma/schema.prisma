generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum TipoUsuario {
  RESPONSAVEL
  CUIDADOR
  ADMIN
  SUPER_ADMIN
}

enum StatusUsuario {
  ATIVO
  BLOQUEADO
  INATIVO
}

enum StatusVerificacao {
  PENDENTE
  APROVADO
  REJEITADO
}

enum Parentesco {
  PROPRIO
  FILHO
  FILHA
  CONJUGE
  NETO
  NETA
  OUTRO
}

enum DiaSemana {
  DOMINGO
  SEGUNDA
  TERCA
  QUARTA
  QUINTA
  SEXTA
  SABADO
}

enum StatusContratacao {
  SOLICITADA
  ACEITA
  RECUSADA
  CANCELADA
  CONCLUIDA
}

model Usuario {
  id          Int           @id @default(autoincrement())
  nome        String        @db.VarChar(150)
  email       String        @unique @db.VarChar(255)
  senhaHash   String        @db.VarChar(255)
  tipoUsuario TipoUsuario
  status      StatusUsuario @default(ATIVO)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  responsavel Responsavel?
  cuidador    Cuidador?
}

model Endereco {
  id          Int     @id @default(autoincrement())
  rua         String  @db.VarChar(150)
  numero      String  @db.VarChar(20)
  complemento String? @db.VarChar(150)
  bairro      String  @db.VarChar(100)
  cidade      String  @db.VarChar(100)
  estado      String  @db.Char(2)
  cep         String  @db.VarChar(8)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  responsaveis Responsavel[]
  idosos       Idoso[]
  cuidadores   Cuidador[]
}

model Responsavel {
  id             Int      @id @default(autoincrement())
  usuarioId      Int      @unique
  enderecoId     Int
  telefone       String   @db.VarChar(20)
  cpf            String   @unique @db.VarChar(11)
  dataNascimento DateTime

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  usuario  Usuario  @relation(fields: [usuarioId], references: [id])
  endereco Endereco @relation(fields: [enderecoId], references: [id])

  responsavelIdosos ResponsavelIdoso[]
  contratacoes      Contratacao[]
}

model ResponsavelIdoso {
  id                   Int        @id @default(autoincrement())
  responsavelId        Int
  idosoId              Int
  parentesco           Parentesco
  responsavelPrincipal Boolean    @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  responsavel Responsavel @relation(fields: [responsavelId], references: [id])
  idoso       Idoso       @relation(fields: [idosoId], references: [id])

  @@unique([responsavelId, idosoId])
}

model Idoso {
  id                    Int      @id @default(autoincrement())
  enderecoId            Int
  nome                  String   @db.VarChar(150)
  dataNascimento        DateTime
  sexo                  String?  @db.VarChar(30)
  telefone              String?  @db.VarChar(20)
  cpf                   String?  @unique @db.VarChar(11)
  observacoes           String?  @db.Text
  necessidadesEspeciais String?  @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  endereco Endereco @relation(fields: [enderecoId], references: [id])

  responsavelIdosos ResponsavelIdoso[]
  contratacoes      Contratacao[]
}

model Cuidador {
  id                      Int               @id @default(autoincrement())
  usuarioId               Int               @unique
  enderecoId              Int
  telefone                String            @db.VarChar(20)
  cpf                     String            @unique @db.VarChar(11)
  dataNascimento          DateTime
  biografia               String?           @db.Text
  experienciaProfissional String?           @db.Text
  registroProfissional    String?           @db.VarChar(100)
  statusVerificacao       StatusVerificacao @default(PENDENTE)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  usuario  Usuario  @relation(fields: [usuarioId], references: [id])
  endereco Endereco @relation(fields: [enderecoId], references: [id])

  cuidadorServicos CuidadorServico[]
  disponibilidades Disponibilidade[]
}

model Servico {
  id        Int     @id @default(autoincrement())
  nome      String  @unique @db.VarChar(150)
  descricao String? @db.Text
  ativo     Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  cuidadorServicos CuidadorServico[]
}

model CuidadorServico {
  id             Int     @id @default(autoincrement())
  cuidadorId     Int
  servicoId      Int
  preco          Decimal @db.Decimal(10, 2)
  duracaoMinutos Int
  ativo          Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  cuidador Cuidador @relation(fields: [cuidadorId], references: [id])
  servico  Servico  @relation(fields: [servicoId], references: [id])

  contratacoes Contratacao[]

  @@unique([cuidadorId, servicoId])
}

model Disponibilidade {
  id         Int       @id @default(autoincrement())
  cuidadorId Int
  diaSemana  DiaSemana
  horaInicio DateTime  @db.Time(0)
  horaFim    DateTime  @db.Time(0)
  ativo      Boolean   @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  cuidador Cuidador @relation(fields: [cuidadorId], references: [id])

  @@unique([cuidadorId, diaSemana, horaInicio, horaFim])
}

model Contratacao {
  id                Int               @id @default(autoincrement())
  responsavelId     Int
  idosoId           Int
  cuidadorServicoId Int
  valorAcordado     Decimal           @db.Decimal(10, 2)
  status            StatusContratacao @default(SOLICITADA)
  observacoes       String?           @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  responsavel     Responsavel     @relation(fields: [responsavelId], references: [id])
  idoso           Idoso           @relation(fields: [idosoId], references: [id])
  cuidadorServico CuidadorServico @relation(fields: [cuidadorServicoId], references: [id])
}
